# Managed by Middleware Hub for {{ mw_cluster.id }}/{{ mw.id }}. Do not edit by hand.
{% if nginx_user_entry is defined and nginx_user_entry.ansible_facts is defined and nginx_user_entry.ansible_facts.getent_passwd is defined and 'nginx' in nginx_user_entry.ansible_facts.getent_passwd %}
user nginx;
{% elif mw_pkg_family == 'apt' and mw.version == '1.24' %}
user www-data;
{% else %}
user nginx;
{% endif %}
worker_processes auto;
pid /run/nginx.pid;
{% if (nginx_modules_dir is defined and nginx_modules_dir.stat is defined and nginx_modules_dir.stat.isdir | default(false)) or (nginx_modules_dir is not defined and (mw_pkg_family != 'apt' or mw.version == '1.24')) %}
{% if mw_pkg_family == 'apt' %}
include /etc/nginx/modules-enabled/*.conf;
{% else %}
include /usr/share/nginx/modules/*.conf;
{% endif %}
{% endif %}

events {
    worker_connections {{ mw.params.worker_connections }};
}

stream {
{% for b in mw.binds %}
    upstream {{ b.name | replace('-', '_') }} {
{% for be in b.endpoint.backends %}
        server {{ be.ip }}:{{ be.port }} max_fails={{ mw.params.max_fails }} fail_timeout={{ mw.params.fail_timeout }}s;
{% endfor %}
    }
    server {
        listen {{ b.listen }};
        proxy_pass {{ b.name | replace('-', '_') }};
        proxy_connect_timeout {{ mw.params.proxy_connect_timeout }}s;
        proxy_timeout {{ mw.params.proxy_timeout }}m;
    }
{% endfor %}
}
