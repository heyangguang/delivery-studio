{% set my_ip = hostvars[inventory_hostname]['ansible_host'] | default(ansible_default_ipv4.address) %}
{% set peers = groups['etcd'] | default([inventory_hostname]) %}
name: "{{ inventory_hostname }}"
data-dir: "{{ etcd_data_dir }}"
listen-peer-urls: "http://{{ my_ip }}:{{ etcd_peer_port }}"
listen-client-urls: "http://{{ my_ip }}:{{ etcd_client_port }},http://127.0.0.1:{{ etcd_client_port }}"
initial-advertise-peer-urls: "http://{{ my_ip }}:{{ etcd_peer_port }}"
advertise-client-urls: "http://{{ my_ip }}:{{ etcd_client_port }}"
initial-cluster: "{% for h in peers %}{{ h }}=http://{{ hostvars[h]['ansible_host'] | default(h) }}:{{ etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %}"
initial-cluster-token: "{{ etcd_cluster_token }}"
initial-cluster-state: "new"
quota-backend-bytes: {{ etcd_quota_backend_bytes }}
auto-compaction-retention: "{{ etcd_auto_compaction_retention }}"
heartbeat-interval: {{ etcd_heartbeat_interval }}
election-timeout: {{ etcd_election_timeout }}
max-snapshots: {{ etcd_max_snapshots }}
max-wals: {{ etcd_max_wals }}
log-level: "{{ etcd_log_level }}"
enable-grpc-gateway: true
