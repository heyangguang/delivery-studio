{% set my_ip = hostvars[inventory_hostname]['ansible_host'] | default('127.0.0.1') -%}
scope: {{ patroni_scope }}
namespace: /service/
name: {{ inventory_hostname }}

restapi:
  listen: 0.0.0.0:{{ patroni_restapi_port }}
  connect_address: {{ my_ip }}:{{ patroni_restapi_port }}

etcd3:
  hosts:
{% if (groups['etcd'] | default([])) | length > 0 %}
{% for h in groups['etcd'] %}
    - {{ hostvars[h]['ansible_host'] | default(h) }}:{{ patroni_etcd_port }}
{% endfor %}
{% else %}
{% for ep in (patroni_external_etcd_hosts.split(',') | map('trim') | reject('equalto', '') | list) %}
    - {{ ep }}
{% endfor %}
{% endif %}

bootstrap:
  dcs:
    ttl: {{ patroni_ttl }}
    loop_wait: {{ patroni_loop_wait }}
    retry_timeout: {{ patroni_retry_timeout }}
    maximum_lag_on_failover: {{ patroni_maximum_lag_on_failover }}
    synchronous_mode: {{ patroni_synchronous_mode | bool | lower }}
{% if patroni_synchronous_mode %}
    synchronous_mode_strict: {{ patroni_synchronous_mode_strict | bool | lower }}
    synchronous_node_count: {{ patroni_synchronous_node_count }}
{% endif %}
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        max_connections: {{ patroni_max_connections }}
        shared_buffers: {{ patroni_shared_buffers }}
        effective_cache_size: {{ patroni_effective_cache_size }}
        maintenance_work_mem: {{ patroni_maintenance_work_mem }}
        work_mem: {{ patroni_work_mem }}
        wal_level: replica
        hot_standby: "on"
        hot_standby_feedback: {{ '"on"' if (patroni_hot_standby_feedback | bool) else '"off"' }}
        wal_keep_size: {{ patroni_wal_keep_size }}
        max_wal_size: {{ patroni_max_wal_size }}
        checkpoint_completion_target: {{ patroni_checkpoint_completion_target }}
        max_wal_senders: {{ patroni_max_wal_senders }}
        max_replication_slots: {{ patroni_max_replication_slots }}
        log_min_duration_statement: {{ patroni_log_min_duration_statement }}
        timezone: {{ patroni_timezone }}
{% if patroni_synchronous_mode %}
        synchronous_commit: {{ patroni_synchronous_commit }}
{% endif %}
        wal_log_hints: "on"
        password_encryption: scram-sha-256
  initdb:
    - encoding: UTF8
    - data-checksums
  pg_hba:
    - local all postgres trust
    - host replication {{ patroni_replication_user }} 127.0.0.1/32 scram-sha-256
    - host replication {{ patroni_replication_user }} {{ patroni_client_cidr }} scram-sha-256
    - host all all 127.0.0.1/32 scram-sha-256
    - host all all {{ patroni_client_cidr }} scram-sha-256
{% for extra_cidr in (patroni_extra_client_cidrs | default([])) %}
    - host all all {{ extra_cidr }} scram-sha-256
{% endfor %}

postgresql:
  listen: 0.0.0.0:{{ patroni_pg_port }}
  connect_address: {{ my_ip }}:{{ patroni_pg_port }}
  data_dir: {{ patroni_data_dir }}
  bin_dir: {{ patroni_pg_bin_dir }}
  pgpass: /tmp/pgpass0
  authentication:
    replication:
      username: {{ patroni_replication_user }}
      password: "{{ patroni_replication_password }}"
    superuser:
      username: postgres
      password: "{{ patroni_superuser_password }}"
    rewind:
      username: {{ patroni_replication_user }}
      password: "{{ patroni_replication_password }}"
  parameters:
    unix_socket_directories: '/var/run/postgresql'
    max_connections: {{ patroni_max_connections }}
    shared_buffers: {{ patroni_shared_buffers }}
    effective_cache_size: {{ patroni_effective_cache_size }}
    maintenance_work_mem: {{ patroni_maintenance_work_mem }}
    work_mem: {{ patroni_work_mem }}
    log_min_duration_statement: {{ patroni_log_min_duration_statement }}
    timezone: {{ patroni_timezone }}

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
