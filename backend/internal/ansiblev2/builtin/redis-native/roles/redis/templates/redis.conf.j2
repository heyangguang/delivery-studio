bind {{ redis_bind_address }}
port {{ redis_port }}
daemonize no
supervised auto
protected-mode yes
dir {{ redis_data_dir }}
databases {{ redis_databases }}
tcp-backlog {{ redis_tcp_backlog }}
tcp-keepalive {{ redis_tcp_keepalive }}
timeout {{ redis_client_timeout }}
loglevel {{ redis_loglevel }}
maxmemory {{ redis_maxmemory }}
maxmemory-policy {{ redis_maxmemory_policy }}
maxmemory-samples {{ redis_maxmemory_samples }}
repl-diskless-sync {{ redis_repl_diskless_sync }}
repl-backlog-size {{ redis_repl_backlog_size }}
replica-priority {{ redis_replica_priority }}
{% if redis_persistence_mode == 'none' %}
save ""
appendonly no
{% elif redis_persistence_mode == 'rdb' %}
save 900 1
save 300 10
appendonly no
{% elif redis_persistence_mode == 'mixed' %}
save 900 1
save 300 10
appendonly yes
aof-use-rdb-preamble yes
{% else %}
save ""
appendonly yes
{% endif %}
{% if redis_password %}
requirepass {{ redis_password }}
masterauth {{ redis_password }}
{% endif %}
{% if inventory_hostname in (groups['replica'] | default([])) and (groups['primary'] | default([])) | length > 0 %}
replicaof {{ hostvars[groups['primary'][0]]['ansible_host'] | default(groups['primary'][0]) }} {{ redis_port }}
replica-read-only yes
{% endif %}
